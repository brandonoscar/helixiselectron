# Chrome DevTools Protocol port the shell exposes for the Playwright execution
# layer to attach to (Weeks 3-4). Defaults to 9222 in dev, off when packaged.
# HELIXIS_CDP_PORT=9222
# Set to 0 to disable CDP entirely.
# HELIXIS_CDP=0

# Override the startup home page (defaults to the built-in helixis://newtab page).
# HELIXIS_HOME=https://example.com
